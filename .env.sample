# Breqy engine runtime
BREQY_ENGINE_SOCKET=            # path to Unix socket, e.g. /tmp/breqy/engine.sock
BREQY_DATA_DIR=                 # base directory for persistent data, e.g. ~/.local/share/breqy
BREQY_LOG_LEVEL=INFO            # logging verbosity: DEBUG | INFO | WARNING | ERROR
BREQY_DB_PATH=                  # path to SQLite database, e.g. ${BREQY_DATA_DIR}/breqy.db

# GitHub
GITHUB_TOKEN=                   # required: gh CLI auth token

# AI provider API keys (only set keys for providers used in routing_rules)
ANTHROPIC_API_KEY=              # Claude runners
OPENAI_API_KEY=                 # Codex runners
GOOGLE_API_KEY=                 # Gemini runners
GITHUB_COPILOT_TOKEN=           # Copilot runners
DASHSCOPE_API_KEY=              # Qwen runners (Alibaba DashScope)

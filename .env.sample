# ============================================================================
# Breqy Configuration
# ============================================================================
# Copy this file to .env and fill in values.
# The CLI auto-loads .env from the current directory or git repo root.
# Paths support ~ (home dir) and $VAR (env var) expansion.
#
# CLI quick start:
#   breqy engine start       Start engine daemon (auto-spawns default agent)
#   breqy engine start --no-agent   Start engine without agent
#   breqy engine stop        Stop running engine
#   breqy engine status      Check if engine is running
#   breqy tui                Launch the Textual TUI (requires running engine)
#   breqy auth <provider>    Authenticate with a model provider
# ============================================================================

# Breqy engine runtime
BREQY_ENGINE_SOCKET=            # path to Unix socket, e.g. /tmp/breqy/engine.sock
BREQY_DATA_DIR=                 # base directory for persistent data, e.g. ~/.local/share/breqy
BREQY_LOG_LEVEL=INFO            # logging verbosity: DEBUG | INFO | WARNING | ERROR
BREQY_DB_PATH=                  # path to SQLite database, e.g. ${BREQY_DATA_DIR}/breqy.db

# GitHub
GITHUB_TOKEN=                   # required: gh CLI auth token

# AI provider API keys (only set keys for providers used in routing_rules)
ANTHROPIC_API_KEY=              # Claude runners
OPENAI_API_KEY=                 # Codex runners
GOOGLE_API_KEY=                 # Gemini runners
# Copilot: uses GitHub OAuth device flow — no API key needed (run: breqy auth copilot)
DASHSCOPE_API_KEY=              # Qwen runners (Alibaba DashScope)
